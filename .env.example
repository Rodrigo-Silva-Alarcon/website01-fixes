# -----------------------------------------------------------------------------
# website01 — Laravel 12 example environment
# -----------------------------------------------------------------------------
# LOCAL (default): sqlite + mail log + APP_DEBUG=true.
# PRODUCTION: see the "PRODUCTION" block at the bottom and docs/fase4-24-env-production.md.
# Never commit a real .env with secrets.
# -----------------------------------------------------------------------------

APP_NAME=SmartHouse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (local: sqlite) ------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (local: log driver — messages written to laravel.log) --------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_EMAIL="hello@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# PRODUCTION — uncomment / override on the server .env (never commit secrets)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://website01.weblinksrl.com
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=warning
#
# # MySQL / PostgreSQL (example — fill with real credentials from the host)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=website01
# DB_USERNAME=website01_user
# DB_PASSWORD=
#
# # Redis for cache/sessions (optional but recommended)
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379
#
# # SMTP (real client credentials — pending from client, do not invent)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"
# CONTACT_EMAIL=
#
# # After deploy:
# #   php artisan migrate --force
# #   php artisan config:cache && php artisan route:cache && php artisan view:cache
